{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nailsalon",
  "compatibility_date": "2026-11-16",
  "assets": {
    // The Vite build writes here (see vite.config.ts).
    "directory": "./host/wwwroot",
    // Unknown paths get index.html, like MapFallbackToFile in host/Program.cs.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "nagels.svgorkom.nl", "custom_domain": true }],
  // No public workers.dev or preview URLs: they would bypass Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false
}
