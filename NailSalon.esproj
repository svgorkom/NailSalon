<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6578810">
  <!--
    Visual Studio JavaScript project: open NailSalon.slnx and press F5.
    F5 uses .vscode/launch.json (it stores what the Start button runs): `npm run dev`; Vite opens the browser.
    StartupCommand only applies to `dotnet run`.
  -->
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <JavaScriptTestRoot>tests\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Vitest</JavaScriptTestFramework>
    <!-- The dev server builds on the fly; a VS build does not need to run Vite. -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
    <!--
      The SDK runs `npm install` on every restore and build. While Visual Studio indexes node_modules that collides with
      files in use (EBUSY). InstallPackages below installs only when package-lock.json changed, as in TriominosTheGame.
    -->
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
  </PropertyGroup>

  <!-- npm writes node_modules/.package-lock.json at the end of every install, so it is newer than package-lock.json afterwards. -->
  <Target Name="InstallPackages" BeforeTargets="Build" Inputs="package-lock.json" Outputs="node_modules\.package-lock.json">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
